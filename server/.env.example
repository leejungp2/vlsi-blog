# server/.env.example
# 실제 값은 .env 파일에 채워 넣으세요 (.env는 git에 절대 commit 금지)

# 서버 포트 (기본 4000)
PORT=4000

# GitHub Personal Access Token
# https://github.com/settings/tokens 에서 발급. scope: repo, read:user 정도
GITHUB_TOKEN=

# OpenAI API Key
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# OpenAI 모델 (선택, 기본 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
